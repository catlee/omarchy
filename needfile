user_themes = "{{env.OMARCHY_THEME_USER_PATH}}"
omarchy_themes = "{{env.OMARCHY_THEME_PATH}}"
symlink_themes = "{{env.OMARCHY_THEME_SYMLINK_DEPS}}"

previews/.built: tree({{user_themes}}) tree({{omarchy_themes}}) {{symlink_themes}}
  @outputs(.need/previews.outputs)
  {{needfile.dir}}/bin/omarchy-theme-preview-build {{user_themes}} {{omarchy_themes}} previews .need/previews.outputs

thumbnails/still/%.jpg:
  @depfile(thumbnails/still/{{stem}}.d)
  {{needfile.dir}}/bin/omarchy-thumbnail-build still {{stem}} {{out}} thumbnails/still/{{stem}}.d

thumbnails/video/%.jpg:
  @depfile(thumbnails/video/{{stem}}.d)
  {{needfile.dir}}/bin/omarchy-thumbnail-build video {{stem}} {{out}} thumbnails/video/{{stem}}.d
