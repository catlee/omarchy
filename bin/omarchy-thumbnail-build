#!/bin/bash

# omarchy:hidden=true

kind="$1"
source="$2"
output="$3"
failed_output="${4:-$output.failed}"

if [[ $kind == "still" ]]; then
  env VIPS_CONCURRENCY=1 vipsthumbnail "$source" --size 1536x864 --smartcrop=centre --path "$output[Q=82,strip]"
elif [[ $kind == "video" ]]; then
  if timeout -k 5 10 ffmpegthumbnailer -i "$source" -o "$output" -s 1536 -q 8; then
    rm -f "$failed_output"
  else
    status=$?
    rm -f "$output"
    if (( status != 124 && status != 137 )); then
      : >"$failed_output"
      exit 0
    fi
    exit "$status"
  fi
else
  echo "Unknown thumbnail kind: $kind" >&2
  exit 1
fi
